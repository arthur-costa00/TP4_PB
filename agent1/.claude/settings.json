{
  "permissions": {
    "allow": [
      "Read(/agent/**)",
      "Read(/tests/**)",
      "Read(/prompts/**)",
      "Read(/data/**)",
      "Bash(uv run python -m unittest discover -s tests -v)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(runtime/**)",
      "Edit(runtime/**)"
    ],
    "ask": [
      "Edit(/agent/**)",
      "Edit(/data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_env.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
